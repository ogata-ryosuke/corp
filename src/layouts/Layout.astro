---
import '@fontsource-variable/geist';
import '../styles/globals.css';
import companyData from '@/lib/company-data.json';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  ogType?: string;
  noindex?: boolean;
}

const {
  title = '株式会社バリアントコード',
  description = '東京・八王子拠点／オンライン対応のソフトウェア開発会社。新規Web・モバイルアプリ開発、既存システムの改善・再設計、AI／LLM機能の開発と評価運用設計まで、要件整理から一貫して支援します。',
  image = '/images/top/logo.jpg',
  ogType = 'website',
  noindex = false,
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? 'https://variantcode.co.jp';
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://variantcode.co.jp').toString();
const ogImage = new URL(image, Astro.site ?? 'https://variantcode.co.jp').toString();

const orgDescription =
  '要件整理から設計・実装・運用まで一貫対応するソフトウェア開発会社。新規Web／モバイルアプリ開発、既存システムの改善・再設計、AI／LLM機能の開発と評価運用設計を支援します。';

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: companyData.companyName,
  alternateName: companyData.companyNameEn,
  url: siteUrl,
  logo: `${siteUrl}/images/top/logo_simple.png`,
  email: companyData.contact.email,
  foundingDate: '2020-02-01',
  description: orgDescription,
  address: {
    '@type': 'PostalAddress',
    postalCode: '192-0082',
    addressRegion: '東京都',
    addressLocality: '八王子市',
    streetAddress: '東町1番14号橋完ビル4階E号室',
    addressCountry: 'JP',
  },
  founder: {
    '@type': 'Person',
    name: '小方 亮佑',
  },
};
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="株式会社バリアントコード" />
    <meta name="theme-color" content="#ffffff" />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}

    <meta property="og:site_name" content="株式会社バリアントコード" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="ja_JP" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/x-icon" href="/images/icon/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/images/icon/apple-icon-180x180.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <script is:inline type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />

    <slot name="head" />

    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-XHLVD4VBSB"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-XHLVD4VBSB');
    </script>
  </head>
  <body class="bg-bg-page">
    <a href="#main-content" class="skip-link">メインコンテンツへスキップ</a>
    <slot />
    <script is:inline>
      (function () {
        if (typeof document === 'undefined') return;
        document.addEventListener('click', function (event) {
          var target = event.target;
          if (!(target instanceof Element)) return;
          var trigger = target.closest('[data-ga-event]');
          if (!trigger) return;
          var name = trigger.getAttribute('data-ga-event');
          if (!name || typeof window.gtag !== 'function') return;
          var params = {};
          for (var i = 0; i < trigger.attributes.length; i++) {
            var attr = trigger.attributes[i];
            if (attr.name.indexOf('data-ga-') === 0 && attr.name !== 'data-ga-event') {
              var key = attr.name.substring('data-ga-'.length).replace(/-([a-z])/g, function (_, c) {
                return c.toUpperCase();
              });
              params[key] = attr.value;
            }
          }
          window.gtag('event', name, params);
        });
      })();
    </script>
  </body>
</html>

<style is:global>
  html {
    font-family: 'Geist Variable', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
  }
</style>
