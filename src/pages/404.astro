---
import Layout from '../layouts/Layout.astro';
---

<Layout title="ページが見つかりません | 株式会社バリアントコード">
  <main class="min-h-screen flex items-center justify-center px-6">
    <div class="text-center">
      <p class="text-sm tracking-widest text-gray-500">404 NOT FOUND</p>
      <h1 class="mt-4 text-3xl md:text-4xl font-bold">ページが見つかりません</h1>
      <p class="mt-4 text-gray-600">
        お探しのページは移動または削除された可能性があります。
      </p>
      <a
        href="/"
        class="inline-block mt-8 px-6 py-3 rounded-md bg-gray-900 text-white hover:bg-gray-700 transition"
      >
        トップへ戻る
      </a>
    </div>
  </main>
</Layout>
