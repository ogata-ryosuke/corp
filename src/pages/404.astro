---
import Layout from '../layouts/Layout.astro';
import Header from '@/components/Header.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import type { CompanyData } from '@/lib/types';
import data from '@/lib/company-data.json';

const companyData = data as CompanyData;
---

<Layout
  title="ページが見つかりません | 株式会社バリアントコード"
  description="お探しのページは移動または削除された可能性があります。トップページから目的の情報をお探しください。"
  noindex
>
  <Header companyName={companyData.companyName} />

  <main id="main-content" tabindex="-1" class="pt-header">
    <div class="min-h-[60vh] flex items-center justify-center px-6 py-2xl">
      <div class="text-center space-y-md">
        <p class="text-small uppercase tracking-[0.2em] text-primary-700 font-semibold font-mono">404 Not Found</p>
        <h1 class="text-3xl md:text-4xl font-bold text-text-primary tracking-tight">ページが見つかりません</h1>
        <p class="text-body text-text-secondary leading-relaxed">
          お探しのページは移動または削除された可能性があります。
        </p>
        <div class="pt-sm">
          <a
            href="/"
            class="inline-flex items-center gap-xs px-6 py-3 rounded-lg bg-text-primary text-white hover:bg-primary-700 transition-colors text-body font-medium"
          >
            トップへ戻る
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
    </div>
  </main>

  <SiteFooter companyName={companyData.companyName} companyNameEn={companyData.companyNameEn} />
</Layout>
