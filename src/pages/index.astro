---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Hero from '@/components/sections/Hero.astro';
import Services from '@/components/sections/Services.astro';
import TargetConsultations from '@/components/sections/TargetConsultations.astro';
import FeaturedWorks from '@/components/sections/FeaturedWorks.astro';
import ContactCTA from '@/components/sections/ContactCTA.astro';
import Message from '@/components/sections/Message.astro';
import CompanyOverview from '@/components/sections/CompanyOverview.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import type { CompanyData } from '@/lib/types';
import data from '@/lib/company-data.json';

const companyData = data as CompanyData;
---

<Layout
  title="株式会社バリアントコード | 受託開発・AI機能開発・既存システム改善"
  description="要件整理から設計・実装・運用まで一貫対応。新規Web／モバイルアプリ開発、既存システム改善・再設計、AI／LLM機能の開発と評価運用設計を支援します。"
>
  <Header companyName={companyData.companyName} />

  <main id="main-content" tabindex="-1" class="pt-header">
    <div class="max-w-[1440px] mx-auto px-4 sm:px-6 md:px-10 lg:px-20 py-6 md:py-xl space-y-xl md:space-y-2xl">
      <Hero heroMessaging={companyData.heroMessaging} careerSheetUrl={companyData.careerSheetUrl} />
      <Services services={companyData.services} />
      <TargetConsultations consultations={companyData.targetConsultations} />
      <FeaturedWorks works={companyData.featuredWorks} careerSheetUrl={companyData.careerSheetUrl} />
      <Message message={companyData.message} />
      <CompanyOverview overview={companyData.overview} />
      <ContactCTA ctaVariants={companyData.ctaVariants} />
    </div>
  </main>

  <SiteFooter companyName={companyData.companyName} companyNameEn={companyData.companyNameEn} />
</Layout>
