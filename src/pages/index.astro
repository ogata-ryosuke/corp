---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import type { CompanyData } from '@/lib/types';
import data from '@/lib/company-data.json';

const companyData = data as CompanyData;
---

<Layout title="株式会社バリアントコード">
  <Header companyName={companyData.companyName} />

  <main class="pt-header">
    <div class="max-w-[1440px] mx-auto px-4 sm:px-6 md:px-10 lg:px-20 py-6 md:py-xl space-y-8 md:space-y-xl">

      {/* Hero Section */}
      <section class="text-center py-xl space-y-md">
        <h2 class="text-4xl sm:text-5xl font-bold text-text-primary">
          <span class="text-primary">プログラミング</span><span>を楽しむ</span>
        </h2>
        <p class="text-body sm:text-lg text-text-secondary">{companyData.subtitle}</p>
        <div class="flex justify-center gap-md pt-md">
          <a href={`mailto:${companyData.contact.email}`} class="inline-flex items-center gap-xs px-6 py-2 bg-primary text-white rounded-lg hover:bg-primary-600 transition-colors text-body font-medium">
            Mail
          </a>
        </div>
      </section>

      {/* 会社概要 Section */}
      <section id="overview" class="space-y-sm scroll-mt-[72px]">
        <h2 class="text-sectionHeading text-text-primary font-bold">会社概要</h2>
        <div class="h-px bg-border-light"></div>
        <div class="bg-bg-surface border border-border-light rounded-card p-lg">
          <table class="w-full">
            <tbody>
              {companyData.overview.map(item => (
                <tr class="border-b border-border-light last:border-0">
                  <th class="py-3 pr-4 text-left align-top text-body font-semibold text-text-primary whitespace-nowrap w-[120px] sm:w-[160px]">
                    {item.label}
                  </th>
                  <td class="py-3 text-body text-text-secondary whitespace-pre-line">
                    {item.value}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      {/* 代表メッセージ Section */}
      <section id="message" class="space-y-sm scroll-mt-[72px]">
        <h2 class="text-sectionHeading text-text-primary font-bold">代表メッセージ</h2>
        <div class="h-px bg-border-light"></div>
        <div class="bg-bg-surface border border-border-light rounded-card p-lg">
          <p class="text-body text-text-primary leading-loose whitespace-pre-line">
            {companyData.message}
          </p>
        </div>
      </section>

      {/* 開発実績 Section */}
      <section id="performance" class="space-y-sm scroll-mt-[72px]">
        <h2 class="text-sectionHeading text-text-primary font-bold">開発実績</h2>
        <div class="h-px bg-border-light"></div>

        {/* サービス領域 */}
        <div class="space-y-lg">
          <h3 class="text-subheading text-text-primary font-semibold text-center">最適なソリューションを提供</h3>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-md">
            {companyData.services.map(service => (
              <div class="bg-bg-surface border border-border-light rounded-card p-lg space-y-sm text-center">
                <h4 class="text-subheading text-text-primary font-semibold">{service.title}</h4>
                <p class="text-body text-text-secondary">{service.description}</p>
              </div>
            ))}
          </div>
        </div>

        {/* 過去の開発実績 */}
        <div class="space-y-md pt-lg">
          {companyData.achievements.map(achievement => (
            <div class="bg-bg-surface border border-border-light rounded-card p-lg space-y-sm">
              <h3 class="text-subheading text-text-secondary font-medium">{achievement.title}</h3>
              <h4 class="text-subheading text-text-primary font-semibold">{achievement.subtitle}</h4>
              <p class="text-body text-text-secondary">{achievement.description}</p>
            </div>
          ))}
        </div>

        {/* 開発言語等 */}
        <div class="space-y-md pt-lg">
          <h3 class="text-subheading text-text-primary font-semibold text-center">開発言語等</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-md">
            {companyData.techStack.map(category => (
              <div class="bg-bg-surface border border-border-light rounded-card p-lg space-y-sm">
                <h4 class="text-body text-text-primary font-semibold">{category.name}</h4>
                <div class="flex flex-wrap gap-xs">
                  {category.items.map(item => (
                    <span class="inline-flex items-center px-2 py-0.5 rounded text-small bg-bg-section text-text-secondary border border-border-light">
                      {item}
                    </span>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* 採用 Section */}
      <section id="recruit" class="space-y-sm scroll-mt-[72px]">
        <h2 class="text-sectionHeading text-text-primary font-bold">採用</h2>
        <div class="h-px bg-border-light"></div>

        {/* 募集要項 */}
        <div class="bg-bg-surface border border-border-light rounded-card p-lg space-y-md">
          <h3 class="text-subheading text-text-primary font-semibold">募集要項</h3>
          <p class="text-body text-text-secondary">{companyData.recruit.description}</p>
          <a
            href={companyData.recruit.indeedUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-xs px-6 py-2 bg-primary text-white rounded-lg hover:bg-primary-600 transition-colors text-body font-medium"
          >
            求人画面
          </a>
        </div>

        {/* フリーランスエンジニア支援 */}
        <div class="bg-bg-surface border border-border-light rounded-card p-lg space-y-sm">
          <h3 class="text-subheading text-text-primary font-semibold">{companyData.recruit.freelance.title}</h3>
          {companyData.recruit.freelance.description.map(text => (
            <p class="text-body text-text-secondary">{text}</p>
          ))}
        </div>
      </section>

    </div>
  </main>

  {/* Footer */}
  <footer class="bg-text-primary text-white mt-xl">
    <div class="max-w-[1440px] mx-auto px-4 sm:px-6 md:px-10 lg:px-20 py-lg">
      <div class="flex flex-col sm:flex-row justify-between items-center gap-md">
        <div>
          <h2 class="text-body font-semibold">{companyData.companyName}</h2>
          <p class="text-small text-text-tertiary">Web開発・アプリ開発・基幹システム設計運用</p>
        </div>
        <p class="text-small text-text-tertiary">We are {companyData.companyNameEn}</p>
      </div>
    </div>
  </footer>
</Layout>
