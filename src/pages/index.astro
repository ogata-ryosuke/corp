---
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import type { CompanyData } from '@/lib/types';
import data from '@/lib/company-data.json';

const companyData = data as CompanyData;

const achievementImages = [
  '/images/top/result_webapp.jpg',
  '/images/top/result_elk.jpg',
];
---

<Layout title="株式会社バリアントコード">
  <Header companyName={companyData.companyName} />

  <main class="pt-header">
    <div class="max-w-[1440px] mx-auto px-4 sm:px-6 md:px-10 lg:px-20 py-6 md:py-xl space-y-8 md:space-y-xl">

      {/* Hero Section */}
      <section class="text-center py-xl space-y-lg">
        <h2 class="text-3xl sm:text-4xl font-bold text-text-primary leading-snug">
          Web・アプリ・基幹システムの<br class="sm:hidden" />開発パートナー
        </h2>
        <p class="text-body sm:text-lg text-text-secondary max-w-2xl mx-auto">
          多言語・フルスタック対応のソフトウェア開発会社です。<br />
          技術スタックや経験案件の詳細は職務経歴書をご覧ください。
        </p>
        <div class="flex flex-col sm:flex-row justify-center gap-md pt-sm">
          <a href="https://cs.variantcode.co.jp/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-xs px-6 py-3 bg-primary text-white rounded-lg hover:bg-primary-600 transition-colors text-body font-medium">
            職務経歴書を見る
          </a>
          <button
            id="copy-email-btn"
            data-email={companyData.contact.email}
            class="inline-flex items-center justify-center gap-xs px-6 py-3 border border-border-light text-text-primary rounded-lg hover:bg-bg-section transition-colors text-body font-medium cursor-pointer"
          >
            案件のご相談・お問い合わせ
          </button>
        </div>
      </section>

      {/* 会社概要 Section */}
      <section id="overview" class="space-y-sm scroll-mt-[72px]">
        <h2 class="text-sectionHeading text-text-primary font-bold">会社概要</h2>
        <div class="h-px bg-border-light"></div>
        <div class="bg-bg-surface border border-border-light rounded-card p-lg">
          <table class="w-full">
            <tbody>
              {companyData.overview.map(item => (
                <tr class="border-b border-border-light last:border-0">
                  <th class="py-3 pr-4 text-left align-top text-body font-semibold text-text-primary whitespace-nowrap w-[120px] sm:w-[160px]">
                    {item.label}
                  </th>
                  <td class="py-3 text-body text-text-secondary whitespace-pre-line">
                    {item.isLink ? (
                      <a href={item.value} target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">{item.value}</a>
                    ) : (
                      item.value
                    )}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>

      {/* 代表メッセージ Section */}
      <section id="message" class="space-y-sm scroll-mt-[72px]">
        <h2 class="text-sectionHeading text-text-primary font-bold">代表メッセージ</h2>
        <div class="h-px bg-border-light"></div>
        <div class="bg-bg-surface border border-border-light rounded-card p-lg">
          <ul class="space-y-sm">
            {companyData.message.map(item => (
              <li class="flex gap-sm items-start">
                <span class="text-primary mt-0.5">-</span>
                <p class="text-body text-text-primary leading-relaxed">{item}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>

      {/* 開発実績 Section */}
      <section id="performance" class="space-y-sm scroll-mt-[72px]">
        <h2 class="text-sectionHeading text-text-primary font-bold">開発実績</h2>
        <div class="h-px bg-border-light"></div>

        {/* 過去の開発実績 */}
        <div class="grid grid-cols-1 md:grid-cols-2 gap-md">
          {companyData.achievements.map((achievement, i) => (
            <div class="bg-bg-surface border border-border-light rounded-card p-lg space-y-sm">
              <h3 class="text-subheading text-text-secondary font-medium">{achievement.title}</h3>
              <h4 class="text-subheading text-text-primary font-semibold">{achievement.subtitle}</h4>
              <p class="text-body text-text-secondary">{achievement.description}</p>
              {achievementImages[i] && (
                <img src={achievementImages[i]} alt={achievement.subtitle} class="w-full rounded mt-sm" />
              )}
            </div>
          ))}
        </div>

      </section>

      {/* 採用 Section */}
      <section id="recruit" class="space-y-sm scroll-mt-[72px]">
        <h2 class="text-sectionHeading text-text-primary font-bold">採用</h2>
        <div class="h-px bg-border-light"></div>

        {/* フリーランスエンジニア支援 */}
        <div class="bg-bg-surface border border-border-light rounded-card p-lg space-y-sm">
          <h3 class="text-subheading text-text-primary font-semibold">{companyData.recruit.freelance.title}</h3>
          {companyData.recruit.freelance.description.map(text => (
            <p class="text-body text-text-secondary">{text}</p>
          ))}
        </div>
      </section>

    </div>
  </main>

  {/* Snackbar */}
  <div id="snackbar" class="fixed bottom-6 left-1/2 -translate-x-1/2 bg-text-primary text-white text-body px-6 py-3 rounded-lg shadow-lg opacity-0 translate-y-4 pointer-events-none transition-all duration-300 z-50">
    メールアドレスをコピーしました
  </div>

  <script>
    const btn = document.getElementById('copy-email-btn');
    const snackbar = document.getElementById('snackbar');
    let timer: ReturnType<typeof setTimeout>;

    btn?.addEventListener('click', async () => {
      const email = btn.getAttribute('data-email') || '';
      await navigator.clipboard.writeText(email);

      snackbar?.classList.remove('opacity-0', 'translate-y-4', 'pointer-events-none');
      snackbar?.classList.add('opacity-100', 'translate-y-0');

      clearTimeout(timer);
      timer = setTimeout(() => {
        snackbar?.classList.add('opacity-0', 'translate-y-4', 'pointer-events-none');
        snackbar?.classList.remove('opacity-100', 'translate-y-0');
      }, 2500);
    });
  </script>

  {/* Footer */}
  <footer class="bg-text-primary text-white mt-xl">
    <div class="max-w-[1440px] mx-auto px-4 sm:px-6 md:px-10 lg:px-20 py-lg">
      <div class="flex flex-col sm:flex-row justify-between items-center gap-md">
        <div>
          <h2 class="text-body font-semibold">{companyData.companyName}</h2>
          <p class="text-small text-text-tertiary">Web開発・アプリ開発・基幹システム設計運用</p>
        </div>
        <p class="text-small text-text-tertiary">We are {companyData.companyNameEn}</p>
      </div>
    </div>
  </footer>
</Layout>
