---
import SectionHeading from './SectionHeading.astro';

interface Props {
  message: string[];
}

const { message } = Astro.props;
---

<section id="message" class="space-y-lg scroll-mt-[72px]">
  <SectionHeading eyebrow="Message" heading="代表メッセージ" />
  <figure class="relative bg-bg-surface border border-border-light rounded-card p-lg md:p-xl overflow-hidden">
    <span
      class="absolute -top-6 left-4 text-[140px] leading-none font-bold text-primary-500/10 select-none pointer-events-none"
      aria-hidden="true">“</span>
    <blockquote class="relative space-y-md">
      {message.map((item, index) => (
        <p class="flex gap-md items-baseline">
          <span class="text-small font-mono tabular-nums text-primary-600 font-semibold flex-shrink-0">
            {String(index + 1).padStart(2, '0')}
          </span>
          <span class="text-lg md:text-xl text-text-primary font-medium leading-relaxed tracking-tight text-pretty">
            {item}
          </span>
        </p>
      ))}
    </blockquote>
    <figcaption class="relative mt-lg pt-md border-t border-border-light text-body text-text-secondary">
      代表取締役　小方 亮佑
    </figcaption>
  </figure>
</section>
