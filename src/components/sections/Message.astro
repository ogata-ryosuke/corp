---
interface Props {
  message: string[];
}

const { message } = Astro.props;
---

<section id="message" class="space-y-sm scroll-mt-[72px]">
  <div class="space-y-xs">
    <p class="text-small uppercase tracking-[0.2em] text-primary-600 font-semibold">Message</p>
    <h2 class="text-sectionHeading md:text-2xl text-text-primary font-bold">代表メッセージ</h2>
  </div>
  <div class="bg-bg-surface border border-border-light rounded-card p-lg">
    <ul class="space-y-sm">
      {message.map(item => (
        <li class="flex gap-sm items-start">
          <span class="text-primary-600 mt-0.5" aria-hidden="true">—</span>
          <p class="text-body text-text-primary leading-relaxed">{item}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
