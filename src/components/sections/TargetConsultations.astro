---
import SectionHeading from './SectionHeading.astro';

interface Props {
  consultations: string[];
}

const { consultations } = Astro.props;
---

<section id="consultations" class="space-y-lg scroll-mt-[72px]">
  <SectionHeading eyebrow="Who we help" heading="向いている相談" />
  <ul class="grid grid-cols-1 md:grid-cols-2 gap-sm">
    {consultations.map(text => (
      <li class="flex gap-sm items-start bg-bg-surface border border-border-light border-l-2 border-l-primary-500/70 rounded-card p-md hover:border-l-primary-500 hover:shadow-sm transition-all">
        <svg class="w-5 h-5 mt-0.5 flex-shrink-0 text-primary-700" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M16.5 5.5 8 14l-4.5-4.5" />
        </svg>
        <p class="text-body text-text-primary leading-relaxed">{text}</p>
      </li>
    ))}
  </ul>
</section>
