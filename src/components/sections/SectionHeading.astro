---
interface Props {
  eyebrow: string;
  heading: string;
}

const { eyebrow, heading } = Astro.props;
---

<div class="space-y-sm">
  <div class="flex items-center gap-sm">
    <span class="h-px w-8 bg-primary-500" aria-hidden="true"></span>
    <p class="text-small uppercase tracking-[0.2em] text-primary-700 font-semibold font-mono">{eyebrow}</p>
  </div>
  <h2 class="text-2xl md:text-3xl font-bold text-text-primary tracking-tight">{heading}</h2>
</div>
