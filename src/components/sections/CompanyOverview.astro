---
import type { OverviewItem } from '@/lib/types';
import SectionHeading from './SectionHeading.astro';

interface Props {
  overview: OverviewItem[];
}

const { overview } = Astro.props;
---

<section id="overview" class="space-y-lg scroll-mt-[72px]">
  <SectionHeading eyebrow="Company" heading="会社概要" />
  <div class="bg-bg-surface border border-border-light rounded-card p-lg">
    <table class="w-full">
      <tbody>
        {overview.map(item => (
          <tr class="border-b border-border-light last:border-0">
            <th class="py-3 pr-4 text-left align-top text-body font-semibold text-text-primary whitespace-nowrap w-[120px] sm:w-[160px]">
              {item.label}
            </th>
            <td class="py-3 text-body text-text-secondary whitespace-pre-line break-words">
              {item.isLink ? (
                <a href={item.value} target="_blank" rel="noopener noreferrer" class="text-primary-700 hover:underline">{item.value}</a>
              ) : (
                item.value
              )}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>
