---
import type { HeroMessaging } from '@/lib/types';

interface Props {
  heroMessaging: HeroMessaging;
  careerSheetUrl: string;
}

const { heroMessaging, careerSheetUrl } = Astro.props;

const capabilities = ['新規Web／モバイルアプリ開発', '既存システムの改善・再設計', 'AI／LLM機能の開発・評価運用'];
---

<section class="relative py-2xl md:py-[6.5rem] overflow-hidden">
  <div class="absolute inset-0 -z-10 pointer-events-none">
    <div class="absolute inset-0 bg-gradient-to-b from-primary-50/50 via-transparent to-transparent"></div>
    <div
      class="absolute inset-0 opacity-40"
      style="background-image:radial-gradient(#d4d4d8 1px, transparent 1px); background-size:22px 22px; -webkit-mask-image:linear-gradient(to bottom, black, transparent 72%); mask-image:linear-gradient(to bottom, black, transparent 72%);"
    >
    </div>
  </div>
  <div class="relative max-w-4xl space-y-lg">
    <div class="flex items-center gap-sm">
      <span class="h-px w-8 bg-primary-500" aria-hidden="true"></span>
      <p class="text-small uppercase tracking-[0.2em] text-primary-700 font-semibold font-mono">Variant Code — Development Partner</p>
    </div>
    <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-text-primary leading-[1.15] tracking-tight text-balance">
      {heroMessaging.headline}
    </h1>
    <p class="text-body sm:text-lg text-text-secondary leading-relaxed max-w-3xl">
      {heroMessaging.sub}
    </p>
    <div class="flex flex-col sm:flex-row gap-md pt-sm">
      <a
        href="#contact"
        class="inline-flex items-center justify-center gap-xs px-6 py-3 bg-text-primary text-white rounded-lg hover:bg-primary-700 transition-colors text-body font-medium"
      >
        案件のご相談
        <span aria-hidden="true">→</span>
      </a>
      <a
        href={careerSheetUrl}
        target="_blank"
        rel="noopener noreferrer"
        data-ga-event="career_sheet_click"
        data-ga-location="hero"
        class="inline-flex items-center justify-center gap-xs px-6 py-3 border border-border-light text-text-primary rounded-lg hover:bg-bg-section transition-colors text-body font-medium"
      >
        職務経歴書を見る
      </a>
    </div>
    <ul class="flex flex-wrap gap-x-lg gap-y-xs pt-lg mt-sm border-t border-border-light/70">
      {capabilities.map(capability => (
        <li class="flex items-center gap-xs text-small text-text-secondary">
          <span class="inline-block w-1 h-1 rounded-full bg-primary-500" aria-hidden="true"></span>
          {capability}
        </li>
      ))}
    </ul>
  </div>
</section>
